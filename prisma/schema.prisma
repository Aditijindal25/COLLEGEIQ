generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model College {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  location              String
  state                 String
  fees                  Int
  pgFees                Int?
  rating                Float
  placement             Float
  academicScore         Float?
  accommodationScore    Float?
  facultyScore          Float?
  infrastructureScore   Float?
  placementScore        Float?
  socialLifeScore       Float?
  nirfRank              Int?
  nirfScore             Float?
  dataSource            String?
  description           String
  website               String?
  courses               Course[]
  reviews               Review[]
  savedBy               SavedCollege[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([name])
  @@index([location])
  @@index([fees])
  @@index([rating])
}

model Course {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  duration  String
  degree    String
  collegeId String  @db.ObjectId
  college   College @relation(fields: [collegeId], references: [id])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  author    String
  collegeId String   @db.ObjectId
  college   College  @relation(fields: [collegeId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String         @unique
  password      String
  savedColleges SavedCollege[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SavedCollege {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  collegeId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  college   College  @relation(fields: [collegeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}
